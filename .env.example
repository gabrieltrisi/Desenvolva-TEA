# Copie este arquivo para .env e ajuste os valores.
# As variáveis são validadas no boot do servidor (src/lib/env.ts).
# NÃO commite o .env real — apenas este .env.example com placeholders.

# --- Banco de dados ---
# String de conexão PostgreSQL. No padrão deste projeto (Docker Compose), o
# host local usa a porta 5433: postgresql://tea:tea@localhost:5433/desenvolva_tea?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# --- Autenticação (JWT em cookie httpOnly) ---
# Gere um segredo forte (mín. 32 caracteres): openssl rand -base64 32
AUTH_SECRET="replace-with-a-secure-random-secret-min-32-chars"

# --- URL pública do site (SEO: metadataBase, robots, sitemap, Open Graph) ---
# Em produção, defina o domínio real (sem barra final), ex.: https://seu-dominio.com.br
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Vídeos via Cloudinary ---
# OPCIONAIS: enquanto vazias, o recurso de vídeo fica desativado e o app sobe normal.
# Crie a conta em cloudinary.com → Dashboard mostra Cloud name / API Key / API Secret.
# CLOUDINARY_API_SECRET é SEGREDO — só servidor (assinatura de upload). Nunca no client.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Pasta onde os vídeos serão organizados (opcional; padrão: desenvolva-tea/videos).
CLOUDINARY_FOLDER="desenvolva-tea/videos"
